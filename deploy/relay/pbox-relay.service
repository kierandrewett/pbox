[Unit]
Description=pbox encrypted connection relay
After=network.target

[Service]
DynamicUser=yes
ExecStart=/usr/local/bin/pbox-relay --listen 0.0.0.0:8080 --key-file ${CREDENTIALS_DIRECTORY}/relay-key
LoadCredential=relay-key:/etc/pbox-relay/relay.key
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
